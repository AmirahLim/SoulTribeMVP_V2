{
  "name": "soul-tribe",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "test": "npm run test --workspace=packages/core && npm run test --workspace=apps/web",
    "test:db": "node scripts/test-database.mjs",
    "test:rls": "node scripts/rls-two-account-test.mjs",
    "typecheck": "tsc --noEmit --incremental false -p apps/web/tsconfig.json"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
